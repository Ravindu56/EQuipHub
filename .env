# ============================================================
# EQuipHub — Root Docker Compose Environment
# COPY this file, fill in real values, NEVER commit real values
# See .env.example for the template
# ============================================================

# Application
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Database
DATABASE_URL=jdbc:postgresql://ep-cold-bar-a1bpiqdv-pooler.ap-southeast-1.aws.neon.tech:5432/neondb?sslmode=require&channel_binding=require
DATABASE_USERNAME=neondb_owner
DATABASE_PASSWORD=REDACTED_DB_PASSWORD

# Redis
UPSTASH_REDIS_REST_URL="https://modern-yeti-78207.upstash.io"
UPSTASH_REDIS_REST_TOKEN="REDACTED_REDIS_TOKEN"
REDIS_HOST=modern-yeti-78207.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=REDACTED_REDIS_TOKEN
REDIS_SSL=true

# JWT — generate with: openssl rand -hex 64
JWT_SECRET=
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Email (Gmail App Password — NOT your account password)
MAIL_USERNAME=
MAIL_PASSWORD=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
