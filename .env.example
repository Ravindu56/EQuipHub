# ============================================================
# EQuipHub — Environment Variables Template
# Copy this file to .env and fill in your real values.
# .env is gitignored — NEVER commit real credentials.
# ============================================================

# Application
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Database
# Local Docker:  jdbc:postgresql://localhost:5432/equiphub_dev
# Neon (cloud):  jdbc:postgresql://<host>/<db>?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/equiphub_dev
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=

# Redis
# Local Docker:  host=localhost, port=6379, password=(empty), ssl=false
# Upstash:       host=<host>.upstash.io, port=6379, password=<token>, ssl=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=false

# JWT — generate a secure secret with: openssl rand -hex 64
JWT_SECRET=
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Email (Gmail SMTP)
# Use a Gmail App Password (NOT your account password).
# How to generate: myaccount.google.com/apppasswords
MAIL_USERNAME=
MAIL_PASSWORD=

# CORS — comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# SIS Integration (optional)
SIS_API_URL=https://sis.university.edu/api
SIS_API_KEY=
